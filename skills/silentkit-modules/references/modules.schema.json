{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SilentKit module catalogue",
  "description": "Versioned engineering patterns; scenario lists are not executed-test evidence.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "about",
    "techniques",
    "patterns",
    "threat_model",
    "modules",
    "entry_contract"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "modules.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "techniques": {
      "type": "object"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "summary"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "threat_model": {
      "type": "object"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "entry_contract": {
      "type": "object"
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "risk",
        "summary",
        "technique",
        "hook",
        "anticheat_notes",
        "settings",
        "bypass_reference",
        "prerequisites",
        "bypass_tips",
        "flag_triggers",
        "validation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "technique": {
          "type": "string",
          "minLength": 1
        },
        "hook": {
          "type": "string",
          "minLength": 1
        },
        "anticheat_notes": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "bypass_reference": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "combat",
            "world",
            "player",
            "movement",
            "render",
            "hud",
            "utility",
            "misc"
          ]
        },
        "risk": {
          "enum": [
            "none",
            "low",
            "med",
            "high",
            "context-dependent"
          ]
        },
        "settings": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "bypass_tips": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "flag_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "validation": {
          "type": "object",
          "required": [
            "status",
            "scenarios"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "source",
                  "scope",
                  "result"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
